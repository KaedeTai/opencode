{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "paths": {
      "@opencode-ai/sdk": ["../sdk/js/src/index.ts"],
      "@opencode-ai/sdk/*": ["../sdk/js/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
