<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for opencode dev session.

  Why this exists:
  - WatchPaths auto-restarts the process when the binary changes
    (e.g., after `bun run build` in packages/opencode). No manual
    restart needed during development.
  - KeepAlive brings it back if it crashes.
  - RunAtLoad starts it on user login.
  - Logs go to /tmp/opencode-dev.{log,err} for tailing.

  Install:
    cp scripts/launchd/com.opencode.dev.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.opencode.dev.plist

  Trigger restart on demand:
    launchctl kickstart -k gui/$(id -u)/com.opencode.dev

  Uninstall:
    launchctl bootout gui/$(id -u)/com.opencode.dev
    rm ~/Library/LaunchAgents/com.opencode.dev.plist

  Customize args: edit ProgramArguments below, then
    launchctl bootout gui/$(id -u)/com.opencode.dev
    launchctl bootstrap gui/$(id -u)/home/Library/LaunchAgents/com.opencode.dev.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.opencode.dev</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kaede/opencode/packages/opencode/dist/opencode-darwin-arm64/bin/opencode</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kaede/opencode</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/kaede/.bun/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/kaede</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!--
      Auto-restart when the opencode binary changes (e.g., after
      `bun run build`). launchd watches these paths for mtime
      changes; one binary change = one restart.
    -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/kaede/opencode/packages/opencode/dist/opencode-darwin-arm64/bin/opencode</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/opencode-dev.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/opencode-dev.err</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
